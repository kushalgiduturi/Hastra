# Hastra Labs: this folder's Content-Security-Policy replaces the site-wide one
# (the root .htaccess sets it with "Header always set", and two policies would
# be enforced together). Keep it identical to LABS_CSP in labs/_boot.php.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://i.ytimg.com; frame-src 'self' https://www.youtube-nocookie.com; connect-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
</IfModule>

# _boot.php and any other _partial are include-only.
<FilesMatch "^_">
    Require all denied
</FilesMatch>
