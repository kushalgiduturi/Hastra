# Vite client-side build vars (VITE_-prefixed vars are bundled into the
# frontend JS, so only put public values here — never secrets). Copy to
# .env.local (git-ignored) and fill in.

# reCAPTCHA v2 "I'm not a robot" site key — the public key from the same
# reCAPTCHA admin registration used for HASTRA_RECAPTCHA_SECRET in .dev.vars.
VITE_RECAPTCHA_SITE_KEY=
