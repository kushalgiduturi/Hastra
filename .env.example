# Hastra — production settings. Copy to .env (never commit .env) and fill in.

# ── Site ──
HASTRA_DOMAIN=hastra.example              # your domain, without https://
HASTRA_APP_URL=https://hastra.example/    # public URL, with the trailing slash
HASTRA_BASE_PATH=/                        # serve at the domain root

# ── Database ──
# Default: the self-hosted `db` container below (created automatically on
# first start). To use a managed database instead (Aiven, PlanetScale, etc.),
# point HASTRA_DB_HOST/PORT/USER/PASS/NAME at it, set HASTRA_DB_SSL_CA to a
# CA cert path (most managed MySQL requires TLS), and remove the `db` service
# from docker-compose.yml so it isn't started.
HASTRA_DB_HOST=db
HASTRA_DB_PORT=3306
HASTRA_DB_NAME=hastra
HASTRA_DB_USER=hastra
HASTRA_DB_PASS=change-me-to-a-long-random-password
HASTRA_DB_ROOT_PASS=change-me-to-another-long-random-password
HASTRA_DB_SSL_CA=

# ── Mail: a real SMTP provider (Brevo, Mailgun, SES, Gmail app password…) ──
# Sign-in codes are emailed, so without working mail nobody can sign in.
HASTRA_MAIL_HOST=smtp-relay.brevo.com
HASTRA_MAIL_PORT=587
HASTRA_MAIL_SECURE=tls
HASTRA_MAIL_AUTH=1
HASTRA_MAIL_USER=
HASTRA_MAIL_PASS=
HASTRA_MAIL_FROM=noreply@hastra.example
HASTRA_MAIL_NAME=Hastra

# ── Accounts ──
HASTRA_SYSADMIN_EMAIL=you@example.com      # this address becomes the primary sysadmin

# ── Google sign-in / reCAPTCHA (see DEPLOY.md) ──
HASTRA_GOOGLE_CLIENT_ID=
HASTRA_GOOGLE_CLIENT_SECRET=
HASTRA_RECAPTCHA_SECRET=

# ── Optional ──
HASTRA_YOUTUBE_API_KEY=                    # ranked videos in the Labs study hub
HASTRA_ANTHROPIC_API_KEY=                  # AI-written documentation drafts
